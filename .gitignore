node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Cloudflare / Wrangler ---
# Estado local de `wrangler dev` (bases locales, caché, builds temporales)
.wrangler/
# Tipos autogenerados por `wrangler types`
worker-configuration.d.ts

# --- Variables y secretos locales (NUNCA subir) ---
.dev.vars
.dev.vars.*
.env
.env.*
# Excepción: plantillas de ejemplo sin valores reales
!.dev.vars.example
!.env.example

# --- Archivos generados ---
dist/
build/
coverage/
.cache/

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
