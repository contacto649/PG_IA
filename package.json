{
  "name": "pg-ai",
  "version": "0.0.0",
  "description": "Proyecto experimental y educativo para aprender a construir progresivamente un sistema de IA y automatización.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply pg-ai-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pg-ai-db --remote"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  }
}
